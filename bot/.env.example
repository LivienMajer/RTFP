# Copy to .env and fill in. .env is gitignored.

# From https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=
# Right-click server / channel in Discord (developer mode on) -> Copy ID
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional, for @mentions: RTFP name:Discord user ID
DISCORD_USER_IDS=Livien:,Daniel:,Sebastian:

# Where the RTFP web app runs and the shared secret from web/.env.local
RTFP_URL=http://localhost:3000
RTFP_BOT_TOKEN=

REMINDER_TIME=18:00
LATE_REMINDER_TIME=21:30
RTFP_TIMEZONE=Europe/Berlin
