# Copy to .env.local and fill in. .env.local is gitignored.

# Claude API key (https://console.anthropic.com). Alternatively `ant auth login`.
ANTHROPIC_API_KEY=

# Names shown on the login page, comma separated
RTFP_USERS=Livien,Daniel,Sebastian

# Active reading path: file name in ../paths without .md
RTFP_PATH=nlp-einstieg

# Days per week that count as "goal reached"
RTFP_WEEKLY_GOAL=5

RTFP_TIMEZONE=Europe/Berlin

# Shared secret for the Discord bot (any long random string, same value in bot/.env)
RTFP_BOT_TOKEN=
